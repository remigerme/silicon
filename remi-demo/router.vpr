domain WellFoundedOrder[T]  {
  
  function bounded(arg1: T): Bool 
  
  function decreasing(arg1: T, arg2: T): Bool 
}

domain __ns__impure_assume_rewriter  {
  
  function __iar__assume_helper_1(c_1: Bool, p_1: Perm, p_0: Perm): Perm 
  
  function __iar__assume_helper_2(c_2: Bool, c_1: Bool, p_2: Perm, p_1: Perm,
  p_0: Perm): Perm 
  
  function __iar__assume_helper_3(c_3: Bool, c_2: Bool, c_1: Bool, p_3: Perm,
  p_2: Perm, p_1: Perm, p_0: Perm): Perm 
  
  axiom __iar__assume_helper_1_axiom {
    (forall c_1: Bool, p_1: Perm, p_0: Perm ::
      { __iar__assume_helper_1(c_1, p_1, p_0) }
      __iar__assume_helper_1(c_1, p_1, p_0) == p_0 + (c_1 ? p_1 : none))
  }
  
  axiom __iar__assume_helper_2_axiom {
    (forall c_2: Bool, c_1: Bool, p_2: Perm, p_1: Perm, p_0: Perm ::
      { __iar__assume_helper_2(c_2, c_1, p_2, p_1, p_0) }
      __iar__assume_helper_2(c_2, c_1, p_2, p_1, p_0) ==
      p_0 + (c_1 ? p_1 : none) + (c_2 ? p_2 : none))
  }
  
  axiom __iar__assume_helper_3_axiom {
    (forall c_3: Bool, c_2: Bool, c_1: Bool, p_3: Perm, p_2: Perm, p_1: Perm,
    p_0: Perm ::
      { __iar__assume_helper_3(c_3, c_2, c_1, p_3, p_2, p_1, p_0) }
      __iar__assume_helper_3(c_3, c_2, c_1, p_3, p_2, p_1, p_0) ==
      p_0 + (c_1 ? p_1 : none) + (c_2 ? p_2 : none) + (c_3 ? p_3 : none))
  }
}

