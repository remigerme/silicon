  axiom {
    (forall x: ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7] ::
      { (ShStructget3of8(x): T3) }
      (ShStructrev3of8((ShStructget3of8(x): T3)): ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7]) ==
      x)
  }
  
  axiom {
    (forall x: ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7] ::
      { (ShStructget4of8(x): T4) }
      (ShStructrev4of8((ShStructget4of8(x): T4)): ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7]) ==
      x)
  }
  
  axiom {
    (forall x: ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7] ::
      { (ShStructget5of8(x): T5) }
      (ShStructrev5of8((ShStructget5of8(x): T5)): ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7]) ==
      x)
  }
  
  axiom {
    (forall x: ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7] ::
      { (ShStructget6of8(x): T6) }
      (ShStructrev6of8((ShStructget6of8(x): T6)): ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7]) ==
      x)
  }
  
  axiom {
    (forall x: ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7] ::
      { (ShStructget7of8(x): T7) }
      (ShStructrev7of8((ShStructget7of8(x): T7)): ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7]) ==
      x)
  }
  
  axiom {
    (forall x: ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7], y: ShStruct8[T0, T1, T2, T3, T4, T5, T6, T7] ::
      { (eq(x, y): Bool) }
      (eq(x, y): Bool) ==
      ((ShStructget0of8(x): T0) == (ShStructget0of8(y): T0) &&
      (ShStructget1of8(x): T1) == (ShStructget1of8(y): T1) &&
      (ShStructget2of8(x): T2) == (ShStructget2of8(y): T2) &&
      (ShStructget3of8(x): T3) == (ShStructget3of8(y): T3) &&
      (ShStructget4of8(x): T4) == (ShStructget4of8(y): T4) &&
      (ShStructget5of8(x): T5) == (ShStructget5of8(y): T5) &&
      (ShStructget6of8(x): T6) == (ShStructget6of8(y): T6) &&
      (ShStructget7of8(x): T7) == (ShStructget7of8(y): T7)))
  }
}

domain Slice[T]  {
  
  function sarray(s: Slice[T]): ShArray[T] 
  
  function scap(s: Slice[T]): Int 
  
  function slen(s: Slice[T]): Int 
  
  function smake(a: ShArray[T], o: Int, l: Int, c: Int): Slice[T] 
  
  function soffset(s: Slice[T]): Int 
  
  axiom deconstructor_over_constructor_array {
    (forall a: ShArray[T], o: Int, l: Int, c: Int ::
      { (sarray((smake(a, o, l, c): Slice[T])): ShArray[T]) }
      0 <= o && (0 <= l && (l <= c && o + c <= (ShArraylen(a): Int))) ==>
      (sarray((smake(a, o, l, c): Slice[T])): ShArray[T]) == a)
  }
  
  axiom deconstructor_over_constructor_cap {
    (forall a: ShArray[T], o: Int, l: Int, c: Int ::
      { (scap((smake(a, o, l, c): Slice[T])): Int) }
      0 <= o && (0 <= l && (l <= c && o + c <= (ShArraylen(a): Int))) ==>
      (scap((smake(a, o, l, c): Slice[T])): Int) == c)
  }
  
  axiom deconstructor_over_constructor_len {
    (forall a: ShArray[T], o: Int, l: Int, c: Int ::
      { (slen((smake(a, o, l, c): Slice[T])): Int) }
      0 <= o && (0 <= l && (l <= c && o + c <= (ShArraylen(a): Int))) ==>
      (slen((smake(a, o, l, c): Slice[T])): Int) == l)
  }
  
  axiom deconstructor_over_constructor_offset {
    (forall a: ShArray[T], o: Int, l: Int, c: Int ::
      { (soffset((smake(a, o, l, c): Slice[T])): Int) }
      0 <= o && (0 <= l && (l <= c && o + c <= (ShArraylen(a): Int))) ==>
      (soffset((smake(a, o, l, c): Slice[T])): Int) == o)
  }
  
  axiom {
    (forall s: Slice[T] ::
      { (sarray(s): ShArray[T]) }
      { (soffset(s): Int) }
      { (slen(s): Int) }
      { (scap(s): Int) }
      s ==
      (smake((sarray(s): ShArray[T]), (soffset(s): Int), (slen(s): Int), (scap(s): Int)): Slice[T]))
  }
  
  axiom {
    (forall s: Slice[T] ::
      { (slen(s): Int) }
      { (scap(s): Int) }
      (slen(s): Int) <= (scap(s): Int))
  }
  
  axiom {
    (forall s: Slice[T] ::
      { (soffset(s): Int), (scap(s): Int) }
      { (ShArraylen((sarray(s): ShArray[T])): Int) }
      (soffset(s): Int) + (scap(s): Int) <=
      (ShArraylen((sarray(s): ShArray[T])): Int))
  }
  
  axiom {
    (forall s: Slice[T] :: { (slen(s): Int) } 0 <= (slen(s): Int))
  }
  
  axiom {
    (forall s: Slice[T] :: { (soffset(s): Int) } 0 <= (soffset(s): Int))
  }
}

